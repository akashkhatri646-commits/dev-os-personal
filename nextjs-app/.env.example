# ---------------------------------------------------------------
# Agentic Health Record Ingestion — environment variables
# Copy to .env.local (local) and to Netlify > Site settings > Environment variables (deploy).
# Values must stay empty in this file. Never commit real values.
# ---------------------------------------------------------------

# App
APP_BASE_URL=                       # Public base URL, e.g. http://localhost:3000 or https://<site>.netlify.app
NEXT_PUBLIC_APP_NAME=               # Display name shown in UI, e.g. "Trust at the Edge"
LOG_LEVEL=                          # pino level: debug | info | warn | error (default info)

# Supabase
NEXT_PUBLIC_SUPABASE_URL=           # Supabase project URL — Settings > API
NEXT_PUBLIC_SUPABASE_ANON_KEY=      # Supabase anon/public key — Settings > API
SUPABASE_SERVICE_ROLE_KEY=          # SERVER ONLY — service role key — Settings > API (bypasses RLS; never expose to client)
SUPABASE_STORAGE_BUCKET=            # Storage bucket name; must be "source-documents" (created by supabase-schema.sql)

# OpenAI (LLM and embeddings)
LLM_PROVIDER=                       # openai | azure_openai - which endpoint LLMClient uses (azure_openai for in-region data residency)
OPENAI_API_KEY=                     # SERVER ONLY - platform.openai.com > API keys (only if LLM_PROVIDER=openai)
AZURE_OPENAI_ENDPOINT=              # Azure OpenAI resource endpoint, e.g. https://<name>.openai.azure.com (only if LLM_PROVIDER=azure_openai)
AZURE_OPENAI_API_KEY=               # SERVER ONLY - Azure OpenAI resource key (only if LLM_PROVIDER=azure_openai)
AZURE_OPENAI_API_VERSION=           # Azure OpenAI API version string, e.g. 2024-10-21 (only if LLM_PROVIDER=azure_openai)
LLM_MODEL_EXTRACTION=               # Model id (Azure: deployment name) for extraction, mapping and scoring - pick a vision-capable model with structured outputs
LLM_MODEL_LIGHT=                    # Cheaper model id (Azure: deployment name) for routing-explanation text
LLM_MAX_INPUT_TOKENS=               # Per-record input token cap, e.g. 150000
LLM_MAX_OUTPUT_TOKENS=              # Per-call output token cap, e.g. 8000
LLM_REQUEST_TIMEOUT_MS=             # Per-call timeout in ms, e.g. 60000
LLM_PRICE_INPUT_PER_MTOK=           # USD per 1M input tokens for LLM_MODEL_EXTRACTION (from your provider's pricing page); used for cost tracking
LLM_PRICE_OUTPUT_PER_MTOK=          # USD per 1M output tokens for LLM_MODEL_EXTRACTION
LLM_DAILY_BUDGET_USD=               # Per-org daily LLM + OCR spend cap in USD, e.g. 200
LLM_MAX_CONCURRENCY_PER_SOURCE=     # Parallel records per source, e.g. 3

# AWS (Textract) - only if OCR_PROVIDER=textract
AWS_REGION=                         # e.g. ap-south-1
AWS_ACCESS_KEY_ID=                  # SERVER ONLY - IAM user/role key limited to Textract
AWS_SECRET_ACCESS_KEY=              # SERVER ONLY - matching secret

# Google Cloud (Document AI) - only if OCR_PROVIDER=documentai
GCP_PROJECT_ID=                     # GCP project id
GCP_LOCATION=                       # e.g. asia-south1
GOOGLE_APPLICATION_CREDENTIALS_JSON= # SERVER ONLY - service-account JSON (single line) with Document AI roles
DOCUMENT_AI_PROCESSOR_ID=           # Document AI OCR processor id - Console > Document AI > Processors

# OCR
OCR_PROVIDER=                       # textract | documentai
OCR_CONFIDENCE_FLOOR=               # 0–1 minimum document OCR confidence before extraction, default 0.80
OCR_MAX_PAGES=                      # Max pages per record, e.g. 40

# Embeddings (terminology retrieval, vector(1024)) - uses the same OpenAI credentials as the LLM
EMBEDDINGS_MODEL=                   # OpenAI embedding model that supports the dimensions parameter, e.g. text-embedding-3-small (requested at 1024 dimensions to match the vector(1024) column)

# Consent
CONSENT_MODE=                       # stub | abdm  (stub in MVP)
ABDM_BASE_URL=                      # ABDM Consent Manager/gateway base URL (sandbox in MVP1) — ABDM sandbox docs
ABDM_CLIENT_ID=                     # SERVER ONLY — ABDM client id issued at sandbox onboarding
ABDM_CLIENT_SECRET=                 # SERVER ONLY — ABDM client secret

# Pipeline / worker
WORKER_SECRET=                      # SERVER ONLY — random 32+ byte string; required header on /api/worker/tick and /api/internal/*
WORKER_BATCH_SIZE=                  # Jobs claimed per tick, e.g. 5
WORKER_TICK_MAX_SECONDS=            # Soft time budget per tick, e.g. 50
WORKER_HOST_LIMIT_SECONDS=          # Host time limit per worker call: set 60 on Netlify, leave empty locally. The tick then stops starting jobs early enough to finish a model call (set LLM_REQUEST_TIMEOUT_MS to 30000-40000 there)
JOB_MAX_ATTEMPTS=                   # Attempts per stage before escalation, default 2
HOLDBACK_PCT_DEFAULT=               # Shadow-review holdback percentage for new sources, default 10
DEFAULT_THRESHOLD=                  # Default routing threshold, default 0.97
MEDICATION_ALLERGY_THRESHOLD=       # Default for MedicationRequest/AllergyIntolerance/lab Observation, default 0.99
REVIEW_LOCK_MINUTES=                # Review task lock duration, default 30
ENABLED_DOC_TYPES=                  # Comma list of doc types accepted now: discharge_summary (MVP), add lab_report at MVP1
SYSTEM_AUTOCOMMIT_ENABLED=          # Global kill switch: true | false. Use false in staging/previews (fails closed)
REVIEWER_COST_PER_MIN=              # Reviewer cost per minute (currency units) for the north-star cost metric; optional until GA

# Security / PHI protection
PATIENT_ID_HMAC_KEY=                # SERVER ONLY — 32-byte base64 key for HMAC lookup hashes of ABHA/MRN
PATIENT_ID_ENC_KEY=                 # SERVER ONLY — 32-byte base64 AES-256-GCM key for stored identifiers
SOURCE_KEY_PEPPER=                  # SERVER ONLY — random string mixed into source API key hashes
SIGNED_URL_TTL_SECONDS=             # Signed document URL lifetime, default 300
MAX_UPLOAD_BYTES=                   # Max upload size, default 26214400 (25 MB)

# FHIR validation
FHIR_VALIDATOR_MODE=                # node | service
FHIR_VALIDATOR_URL=                 # Base URL of the HL7 validator service (only when FHIR_VALIDATOR_MODE=service)
FHIR_VALIDATOR_TOKEN=               # SERVER ONLY — bearer token for the validator service

# Rate limiting
RATE_LIMIT_USER_PER_MIN=            # Default 60
RATE_LIMIT_SOURCE_KEY_PER_MIN=      # Default 120

# Monitoring & alerts
SENTRY_DSN=                         # SERVER ONLY — Sentry project DSN
NEXT_PUBLIC_SENTRY_DSN=             # Sentry browser DSN (public, no PHI is sent)
ALERT_WEBHOOK_URL=                  # Slack/Teams incoming webhook for alerts (STP drift, auto-pause, downstream error)
ALERT_STP_DELTA_POINTS=             # Alert if weekly STP moves by more than this, default 5
ALERT_ESCALATION_PRECISION_MIN=     # Alert below this value, default 0.60
ALERT_CORRECTION_RATE_MAX=          # Alert above this auto-commit sample correction rate, default 0.01

# Testing / CI (never set in production)
E2E_ADMIN_EMAIL=                    # Seeded test admin email for Playwright
E2E_ADMIN_PASSWORD=                 # Seeded test admin password for Playwright
EVAL_DATASET_BUCKET_PATH=           # Storage path prefix of de-identified eval datasets

# Source evaluation bar (all optional; defaults shown)
EVAL_MIN_RECORDS=                   # Reviewed records needed before a verdict, default 50
EVAL_MIN_FIELDS=                    # Reviewed fields needed before a verdict, default 300
EVAL_TARGET_ACCURACY=               # Lower-bound accuracy for medication/allergy/lab fields, default 0.99
EVAL_TARGET_ACCURACY_OTHER=         # Lower-bound accuracy for other fields, default 0.97
EVAL_TARGET_CODE_ACCURACY=          # Code accuracy, default 0.95
EVAL_MIN_RESOURCES_AT_THRESHOLD=    # Resources needed above a threshold before suggesting it, default 30
